<!-- index.html -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Happy Birthday Surprise</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Allura&family=Cormorant+Garamond:wght@500;600;700&family=Reenie+Beanie&family=Special+Elite&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css?v=9">
</head>
<body>
  <!-- ============ Reusable SVG Assets ============ -->
  <svg width="0" height="0" style="position:absolute; overflow:hidden;" aria-hidden="true">
    <defs>
      <symbol id="star4" viewBox="0 0 100 100"><path d="M50 0 C54 34 66 46 100 50 C66 54 54 66 50 100 C46 66 34 54 0 50 C34 46 46 34 50 0Z" fill="#d9d9de" stroke="#222" stroke-width="3"/></symbol>
      <symbol id="redstar" viewBox="0 0 100 100"><path d="M50 4 62 36 96 38 70 59 79 92 50 73 21 92 30 59 4 38 38 36Z" fill="#a31218" stroke="#5c0509" stroke-width="3" stroke-linejoin="round"/></symbol>
      
      <!-- Normal Cute Ghost -->
      <symbol id="ghostS" viewBox="0 0 200 200">
        <ellipse cx="100" cy="82" rx="62" ry="58" fill="#f4f1ec" stroke="#222" stroke-width="4"/>
        <ellipse cx="78" cy="88" rx="22" ry="25" fill="#5a0a14" stroke="#222" stroke-width="3"/>
        <ellipse cx="124" cy="88" rx="22" ry="25" fill="#5a0a14" stroke="#222" stroke-width="3"/>
        <circle cx="72" cy="80" r="7" fill="#fff"/><circle cx="118" cy="80" r="7" fill="#fff"/>
        <circle cx="84" cy="98" r="3" fill="#e55"/><circle cx="130" cy="98" r="3" fill="#e55"/>
        <path d="M40 140 Q20 130 24 150 Q40 168 70 150 Q100 158 130 150 Q160 168 176 150 Q180 130 160 140 Q130 150 100 142 Q70 150 40 140Z" fill="#f4f1ec" stroke="#222" stroke-width="4"/>
      </symbol>

      <!-- Sad Crying Ghost -->
      <symbol id="ghostSad" viewBox="0 0 200 200">
        <ellipse cx="100" cy="82" rx="62" ry="58" fill="#f4f1ec" stroke="#222" stroke-width="4"/>
        <ellipse cx="78" cy="92" rx="18" ry="12" fill="#5a0a14" stroke="#222" stroke-width="3"/>
        <ellipse cx="124" cy="92" rx="18" ry="12" fill="#5a0a14" stroke="#222" stroke-width="3"/>
        <path d="M78 104 q-3 12 0 20 M124 104 q3 12 0 20" stroke="#7bb9f2" stroke-width="5" stroke-linecap="round" stroke-dasharray="2 6" fill="none"/>
        <path d="M90 115 Q100 105 110 115" stroke="#222" stroke-width="3" fill="none" stroke-linecap="round"/>
        <path d="M40 140 Q20 130 24 150 Q40 168 70 150 Q100 158 130 150 Q160 168 176 150 Q180 130 160 140 Q130 150 100 142 Q70 150 40 140Z" fill="#f4f1ec" stroke="#222" stroke-width="4"/>
      </symbol>

      <!-- Ghost With Love -->
      <symbol id="ghostLove" viewBox="0 0 200 200">
        <ellipse cx="100" cy="90" rx="60" ry="50" fill="#f6f1ee" stroke="#222" stroke-width="4"/>
        <path d="M72 80c-6-8-16 0-8 8l8 8 8-8c8-8-2-16-8-8Zm56 0c-6-8-16 0-8 8l8 8 8-8c8-8-2-16-8-8Z" fill="#e35d6a"/>
        <circle cx="62" cy="110" r="6" fill="#f3a0a8"/><circle cx="138" cy="110" r="6" fill="#f3a0a8"/>
        <path d="M86 118q14 8 28 0" stroke="#222" stroke-width="3" fill="none"/>
        <path d="M70 138q-16 20 0 40h60q16-20 0-40" fill="#f6f1ee" stroke="#222" stroke-width="4"/>
      </symbol>

      <!-- Flowers -->
      <symbol id="roseR" viewBox="-30 -34 60 68">
        <path d="M-25 -4Q-27 -27 0 -31Q27 -27 25 -4Q23 19 0 25Q-23 19 -25 -4Z" fill="#6d0a14"/>
        <path d="M-20 -3Q-21 -22 0 -25Q21 -22 20 -3Q18 15 0 19Q-18 15 -20 -3Z" fill="#a8131f"/>
        <path d="M-20 -4Q-9 -17 3 -12Q-3 3 -1 19Q-17 13 -20 -4Z" fill="#c4202c"/>
        <path d="M20 -4Q9 -19 -3 -13Q3 4 1 19Q17 13 20 -4Z" fill="#8e101b"/>
        <path d="M-8 -16Q0 -23 9 -14Q6 -6 -1 -8Q-8 -9 -8 -16Z" fill="#d8404a"/>
        <path d="M-3 -15Q2 -18 5 -14" fill="none" stroke="#7a0b16" stroke-width="1.6" stroke-linecap="round"/>
        <path d="M-15 -12Q-9 -20 -1 -21" fill="none" stroke="#fff" stroke-opacity=".28" stroke-width="1.6" stroke-linecap="round"/>
        <path d="M-14 8Q-6 17 4 16" fill="none" stroke="#3c0509" stroke-opacity=".45" stroke-width="1.4" stroke-linecap="round"/>
      </symbol>
      <symbol id="bouquet" viewBox="0 0 220 260">
        <defs>
          <linearGradient id="bqGL" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4a9a67"/><stop offset="1" stop-color="#1d5a3a"/></linearGradient>
          <linearGradient id="bqGR" x1="1" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2f7a4d"/><stop offset="1" stop-color="#143d27"/></linearGradient>
          <linearGradient id="bqGF" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3c8c5b"/><stop offset="1" stop-color="#173f29"/></linearGradient>
        </defs>
        <g class="bq-sway">
          <g fill="none" stroke-linecap="round" stroke-width="4">
            <path d="M106 205L82 256" stroke="#5f7a3e"/>
            <path d="M109 205L97 258" stroke="#6f8a4a"/>
            <path d="M112 205L112 259" stroke="#4d6532"/>
            <path d="M115 205L127 258" stroke="#6f8a4a"/>
            <path d="M118 205L142 254" stroke="#5f7a3e"/>
          </g>
          <path d="M110 62L50 96L74 150L100 206L120 206L146 150L170 96Z" fill="#14402a"/>
          <path d="M50 96L110 62L170 96L152 108Q110 94 68 108Z" fill="#c9dfcc"/>
          <path d="M66 104Q110 90 154 104" fill="none" stroke="#9cc4a6" stroke-width="1.2"/>
          <path d="M100 206L22 84L64 96L96 146Z" fill="url(#bqGL)"/>
          <path d="M120 206L200 100L156 104L124 146Z" fill="url(#bqGR)"/>
          <path d="M100 206L64 96M120 206L156 104M98 178L44 92M122 178L182 102M90 152L52 98M130 152L168 106" stroke="#8fd1a6" stroke-opacity=".35" stroke-width="1.2" fill="none"/>
          <path d="M96 190L58 120M124 190L166 124" stroke="#0e2f1d" stroke-opacity=".4" stroke-width="1.4" fill="none"/>
          <path d="M22 84L64 96M200 100L156 104" stroke="#b8e6c6" stroke-width="1.8" stroke-linecap="round"/>
          <g transform="translate(60 112) rotate(-70)"><g class="bq-leaf"><path d="M0 0Q11 -13 0 -34Q-11 -13 0 0Z" fill="#2f4a2a"/></g></g>
          <g transform="translate(160 112) rotate(70)"><g class="bq-leaf b"><path d="M0 0Q11 -13 0 -34Q-11 -13 0 0Z" fill="#2f4a2a"/></g></g>
          <g class="bq-rose r2"><use href="#roseR" x="40" y="67" width="44" height="50" transform="rotate(-18 62 92)"/></g>
          <g class="bq-rose r3"><use href="#roseR" x="136" y="67" width="44" height="50" transform="rotate(18 158 92)"/></g>
          <g class="bq-rose r4"><use href="#roseR" x="62" y="41" width="44" height="50" transform="rotate(-8 84 66)"/></g>
          <g class="bq-rose r6"><use href="#roseR" x="114" y="41" width="44" height="50" transform="rotate(8 136 66)"/></g>
          <g class="bq-rose r1"><use href="#roseR" x="87" y="22" width="46" height="52"/></g>
          <g class="bq-rose r5"><use href="#roseR" x="73" y="70" width="46" height="52" transform="rotate(-5 96 96)"/></g>
          <g class="bq-rose r7"><use href="#roseR" x="101" y="70" width="46" height="52" transform="rotate(5 124 96)"/></g>
          <g class="bq-rose r2"><use href="#roseR" x="88" y="97" width="44" height="50"/></g>
          <path d="M68 128Q110 150 152 128L126 208L94 208Z" fill="url(#bqGF)"/>
          <path d="M68 128Q110 150 152 128" fill="none" stroke="#b8e6c6" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M78 139Q110 157 142 139" fill="none" stroke="#d8f0de" stroke-opacity=".65" stroke-width="1.4" stroke-dasharray="2 4" stroke-linecap="round"/>
          <path d="M96 152L104 206M124 152L116 206M110 150L110 207" stroke="#0f2f1d" stroke-opacity=".5" stroke-width="1.3" fill="none"/>
          <path d="M90 158L99 205M130 158L121 205" stroke="#8fd1a6" stroke-opacity=".3" stroke-width="1.1" fill="none"/>
          <path d="M92 204Q110 214 128 204" fill="none" stroke="#0c0c0c" stroke-width="6" stroke-linecap="round"/>
          <path d="M110 205Q88 190 84 204Q90 217 110 205Z" fill="#0c0c0c"/>
          <path d="M110 205Q132 190 136 204Q130 217 110 205Z" fill="#0c0c0c"/>
          <path d="M104 203Q94 198 90 204" fill="none" stroke="#3a3a3a" stroke-width="1.2" stroke-linecap="round"/>
          <path d="M116 203Q126 198 130 204" fill="none" stroke="#3a3a3a" stroke-width="1.2" stroke-linecap="round"/>
          <circle cx="110" cy="206" r="4" fill="#1d1d1d"/>
          <path d="M108 210Q101 226 95 236M112 210Q119 226 125 236" fill="none" stroke="#0c0c0c" stroke-width="3" stroke-linecap="round"/>
        </g>
      </symbol>

      <!-- Envelope Elements -->
      <symbol id="envelope" viewBox="0 0 220 190">
        <path d="M110 8 214 80H6Z" fill="#a8141a"/>
        <rect x="40" y="35" width="140" height="100" rx="4" fill="#d8cfb7"/>
        <path d="M6 70 110 140 214 70V176Q214 184 206 184H14Q6 184 6 176Z" fill="#8e0f14"/>
        <path d="M6 70 110 150 214 70" stroke="#6b0a0e" stroke-width="3" fill="none"/>
      </symbol>
      
      <!-- Gift Box Elements -->
      <symbol id="giftbox" viewBox="0 0 200 200">
        <defs>
          <linearGradient id="gxBody" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#b3121b"/><stop offset=".5" stop-color="#d21c27"/><stop offset="1" stop-color="#9a0f17"/></linearGradient>
          <linearGradient id="gxSide" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7d0b12"/><stop offset="1" stop-color="#5c070c"/></linearGradient>
          <linearGradient id="gxLid" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#bf141e"/><stop offset=".5" stop-color="#df2430"/><stop offset="1" stop-color="#a8101a"/></linearGradient>
          <linearGradient id="gxTop" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ee3a45"/><stop offset="1" stop-color="#c4161f"/></linearGradient>
          <linearGradient id="gxRib" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#1c8a4c"/><stop offset=".45" stop-color="#52c783"/><stop offset="1" stop-color="#17703d"/></linearGradient>
          <linearGradient id="gxBow" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#62d791"/><stop offset="1" stop-color="#1a8a4b"/></linearGradient>
        </defs>
        <ellipse cx="102" cy="189" rx="64" ry="7" fill="#000" opacity=".16"/>
        <path d="M44 100L146 100L146 184L44 184Z" fill="url(#gxBody)"/>
        <path d="M146 100L158 92L158 177L146 184Z" fill="url(#gxSide)"/>
        <path d="M84 100L106 100L106 184L84 184Z" fill="url(#gxRib)"/>
        <path d="M89 102L89 182" stroke="#b9f0cf" stroke-opacity=".45" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M44 100L146 100L146 108L44 108Z" fill="#000" opacity=".2"/>
        <path d="M152 78L164 70L164 92L152 100Z" fill="url(#gxSide)"/>
        <path d="M38 78L152 78L152 100L38 100Z" fill="url(#gxLid)"/>
        <path d="M84 78L106 78L106 100L84 100Z" fill="url(#gxRib)"/>
        <path d="M38 78L50 70L164 70L152 78Z" fill="url(#gxTop)"/>
        <path d="M84 78L106 78L118 70L96 70Z" fill="url(#gxRib)"/>
        <path d="M40 80L150 80" stroke="#ff8f98" stroke-opacity=".45" stroke-width="1.3" stroke-linecap="round"/>
        <g class="gb-bow">
          <path d="M94 77C82 89 64 99 48 119L60 127C74 111 90 99 104 83Z" fill="url(#gxBow)"/>
          <path d="M106 77C120 87 136 95 148 111L138 119C126 105 112 95 98 83Z" fill="url(#gxBow)"/>
          <path d="M52 114L60 121M141 106L135 113" stroke="#0f5a30" stroke-opacity=".5" stroke-width="1.4" stroke-linecap="round"/>
          <path d="M100 73C72 30 38 38 48 62C56 80 90 80 100 73Z" fill="url(#gxBow)"/>
          <path d="M100 73C128 28 162 36 152 62C144 80 110 80 100 73Z" fill="url(#gxBow)"/>
          <path d="M96 71C76 44 56 48 60 62C64 72 86 74 96 71Z" fill="#126f3c" opacity=".55"/>
          <path d="M104 71C124 42 146 46 142 62C138 72 114 74 104 71Z" fill="#126f3c" opacity=".55"/>
          <path d="M60 52C70 44 82 50 90 60M140 52C130 44 118 50 110 60" fill="none" stroke="#c9f7da" stroke-opacity=".6" stroke-width="1.6" stroke-linecap="round"/>
          <ellipse cx="100" cy="75" rx="12" ry="10" fill="url(#gxBow)"/>
          <path d="M92 71Q100 65 108 71" fill="none" stroke="#d8fbe6" stroke-opacity=".75" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M92 79Q100 85 108 79" fill="none" stroke="#0f5a30" stroke-opacity=".5" stroke-width="1.6" stroke-linecap="round"/>
        </g>
      </symbol>

      <symbol id="heartSeal" viewBox="0 0 60 60">
        <circle cx="30" cy="30" r="27" fill="#7a0b11"/>
        <path d="M30 44C14 32 16 18 26 18c4 0 4 3 4 4 0-1 0-4 4-4 10 0 12 14-4 26Z" fill="#c0202a" stroke="#4a060a" stroke-width="2"/>
      </symbol>
      
      <symbol id="vinylS" viewBox="0 0 120 100">
        <circle cx="50" cy="55" r="42" fill="#111"/>
        <circle cx="50" cy="55" r="30" fill="none" stroke="#333" stroke-width="1"/>
        <circle cx="50" cy="55" r="16" fill="#f3e9e0"/>
        <path d="M50 64C40 56 41 48 47 48c2 0 3 2 3 3 0-1 1-3 3-3 6 0 7 8-3 16Z" fill="#c0202a"/>
        <path d="M95 8 62 50" stroke="#222" stroke-width="5" stroke-linecap="round"/>
      </symbol>
    </defs>
  </svg>

  <!-- Background Decor -->
  <div class="gingham g-tr"></div>
  <div class="gingham g-r"></div>
  <div class="gingham g-bl"></div>
  <div class="gingham g-l"></div>
  <svg class="deco star"><use href="#redstar"/></svg>
  <svg class="deco sparkle" viewBox="0 0 100 100"><use href="#star4"/></svg>

  <!-- ============ SCREEN 1: CAKE ============ -->
  <section class="screen active" id="s1">
    <svg class="bunting l" viewBox="0 0 400 130" fill="none" stroke="#b5565c" stroke-width="2">
      <path d="M5 10Q200 60 395 10M5 40Q150 90 300 30"/>
      <g fill="#f4ece3">
        <path d="M30 25l14 34 14-30zM80 38l14 34 14-30zM130 46l14 34 14-30zM180 48l14 34 14-30zM230 46l14 34 14-30zM280 40l14 34 14-30zM330 30l14 34 14-30z"/>
      </g>
    </svg>
    <svg class="bunting r" viewBox="0 0 400 130" fill="none" stroke="#b5565c" stroke-width="2">
      <path d="M5 10Q200 60 395 10M5 40Q150 90 300 30"/>
      <g fill="#f4ece3">
        <path d="M30 25l14 34 14-30zM80 38l14 34 14-30zM130 46l14 34 14-30zM180 48l14 34 14-30zM230 46l14 34 14-30zM280 40l14 34 14-30zM330 30l14 34 14-30z"/>
      </g>
    </svg>
    <svg class="deco cocktail" viewBox="0 0 100 160">
      <path d="M10 20h80L50 80Z" fill="#b5121a" stroke="#400" stroke-width="3"/>
      <path d="M50 80v60M30 145h40" stroke="#400" stroke-width="5"/>
      <circle cx="82" cy="20" r="12" fill="#7a0b11"/>
    </svg>
    <svg class="deco disco" viewBox="0 0 100 100">
      <circle cx="50" cy="50" r="44" fill="#9a9a9e" stroke="#333" stroke-width="3"/>
      <g stroke="#333" stroke-width="1.5" fill="none">
        <path d="M6 50h88M50 6v88M18 22Q50 40 82 22M18 78Q50 60 82 78M22 18Q40 50 22 82M78 18Q60 50 78 82"/>
      </g>
    </svg>

    <h1>Happy Birthday</h1>
    <div class="wish">MAKE A WISH!!</div>
    <button class="btn pill" id="blow">≋ &nbsp;BLOW THE CANDLES</button>
    <svg class="cake" id="cake" viewBox="0 0 330 260" fill="none" stroke="#a31820" stroke-width="2.4" stroke-linecap="round">
      <g class="flame"><path d="M165 22c-10 16-8 28 0 32 8-4 10-16 0-32Z" fill="#f6c453" stroke="#d98a1c"/></g>
      <path class="smoke" d="M165 50c-8-10 8-18 0-30s6-16 2-26"/>
      <rect x="156" y="52" width="18" height="46" fill="#f3d9d9"/>
      <path d="M156 62l18 8M156 76l18 8M156 90l18 6"/>
      <ellipse cx="165" cy="115" rx="105" ry="30" fill="#f4ece3"/>
      <path d="M60 115v90Q60 245 165 245t105-40v-90" fill="#f4ece3"/>
      <path d="M70 140c30 14 60 14 95 0s65 -6 95 0M72 170c40 14 70 14 93 0s60-8 93 0"/>
      <path d="M110 130l20 20-20 20M220 130l-20 20 20 20"/>
    </svg>
    <canvas id="confetti-canvas"></canvas>
  </section>

  <!-- ============ SCREEN 2: QUESTION ============ -->
  <section class="screen" id="s2">
    <h2><i>PLEASE</i> ACCEPT THE GIFT</h2>
    <svg class="ghost bob-anim" viewBox="0 0 200 200"><use href="#ghostS"/></svg>
    <div class="yn-group">
      <button class="btn yn-btn" data-go="s4">YES</button>
      <button class="btn yn-btn" id="btn-no" data-go="s3">NO</button>
    </div>
  </section>

  <!-- ============ SCREEN 3: SAD REACTION ============ -->
  <section class="screen" id="s3">
    <h2>WHY DID YOU CLICK NO!</h2>
    <svg class="ghost shake-anim" viewBox="0 0 200 200"><use href="#ghostSad"/></svg>
    <div class="yn-group" style="margin-top: 20px;">
      <button class="btn yn-btn" data-go="s2">TRY AGAIN</button>
    </div>
  </section>

  <!-- ============ SCREEN 4: CHOOSE GIFTS ============ -->
  <section class="screen" id="s4">
    <h2 class="red-title">Choose Your Gifts</h2>
    <div class="gifts">
      <button class="gift-btn" data-gift="env" data-go="s5" aria-label="Open the letter">
        <svg viewBox="0 0 220 190"><use href="#envelope"/><use href="#heartSeal" x="85" y="95" width="50" height="50"/></svg>
      </button>
      <button class="gift-btn" data-gift="flo" data-go="s6" aria-label="Open the flowers">
        <svg viewBox="0 0 220 260" style="transform:rotate(-6deg)"><use href="#bouquet"/></svg>
      </button>
      <button class="gift-btn" data-gift="box" data-go="s7" aria-label="Open the gift box">
        <svg viewBox="0 0 200 200"><use href="#giftbox"/></svg>
      </button>
    </div>
    <button class="btn pill final-reveal-btn hidden" id="btn-final" data-go="s8">✨ SEE FINAL SURPRISE ✨</button>
  </section>

  <!-- ============ SCREEN 5: LETTER ============ -->
  <section class="screen" id="s5">
    <button class="btn back" data-go="s4">← Back</button>
    <div class="env-container" id="env">
      <div class="paper">
        <h3>Happy Birthday</h3>
        <p id="letter-to" class="letter-meta"></p>
        <p id="letter-body"></p>
      </div>
      <svg class="front" viewBox="0 0 220 190">
        <path d="M6 70 110 140 214 70V176Q214 184 206 184H14Q6 184 6 176Z" fill="#8e0f14"/>
        <path d="M6 70 110 150 214 70" stroke="#6b0a0e" stroke-width="3" fill="none"/>
      </svg>
      <svg class="seal" viewBox="0 0 60 60"><use href="#heartSeal"/></svg>
      <svg viewBox="0 0 220 190" class="back-flap">
        <path d="M110 8 214 80H6Z" fill="#a8141a"/>
      </svg>
    </div>
  </section>

  <!-- ============ SCREEN 6: FLOWERS ============ -->
  <section class="screen" id="s6">
    <button class="btn back" data-go="s4">← Back</button>
    <div class="hand-text" id="flowerText">flowers for<br>my sweetheart!<br><span class="red-heart">♥</span></div>
    <svg class="ghost-abs" viewBox="0 0 200 200"><use href="#ghostLove"/></svg>
    <div class="tag t-a">my favorite person</div>
    <div class="tag t-b">i'm your #1 fan</div>
    <svg class="bouq shadow-hover" viewBox="0 0 220 260"><use href="#bouquet"/></svg>
  </section>

  <!-- ============ SCREEN 7: GIFT / MUSIC CARD ============ -->
  <section class="screen" id="s7">
    <button class="btn back" data-go="s4">← Back</button>
    <div class="tiles" id="tiles"></div>
    <div class="vinyl-container">
      <svg class="vinyl-record" viewBox="0 0 120 100"><use href="#vinylS"/></svg>
      <div class="lyr">and suddenly,<br>all the love<br>songs were about<br>you ♥</div>
    </div>
    <div class="polaroid-card">
      <b>I LOVE YOU</b>
      <svg viewBox="0 0 200 200" class="ghost-card"><use href="#ghostLove"/></svg>
      <b>Sooooo...! MUCH ♥</b>
    </div>
    <div class="player">
      <div class="art"></div>
      <div class="track-info">I Guess I’m In Love<small>Clinton Kane</small></div>
      <button class="btn-play" id="play" aria-label="Play or pause">▶</button>
    </div>
    <audio id="song" src="song.mp3" loop></audio>
  </section>

  <!-- ============ SCREEN 8: FINAL MEMORIES ============ -->
  <section class="screen" id="s8">
    <div class="final-container">
      <h1 class="final-title">Happy Birthday!</h1>
      <p class="final-subtitle">Here's to making more beautiful memories together.</p>
      <div class="photo-frame shadow-hover">
         <!-- The user can replace the background image here later, currently a lovely aesthetic placeholder -->
         <div class="photo-placeholder">
           <img src="photo.jpg" alt="Us">
         </div>
         <div class="photo-caption">You mean the world to me ✨</div>
      </div>
      <button class="btn pill restart-btn" data-go="s1">↺ RESTART SURPRISE</button>
    </div>
    <canvas id="final-confetti"></canvas>
  </section>

<script src="script.js?v=3"></script>
</body>
</html>
